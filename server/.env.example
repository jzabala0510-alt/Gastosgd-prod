PORT=3101

# Conexion a la BD - SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_NAME=Ardene          # dev: Ardene  |  prod: GASTOSGD (BD propia de la app)
DB_GENERAL=GENERAL
DB_ENCRYPT=false
DB_TRUST_CERT=true
ARDENE_CODEMPRESA=25

# Host de las BD de marca. dev: localhost (copias locales). prod: el server real
# (p. ej. 172.16.20.30) para que TODAS las marcas conecten ahi. Vacio = usar el host del PATHBD.
# Excepcion: una marca en un servidor de verdad distinto (con su propio usuario/clave)
# se declara en server/servers-extra.json (ver servers-extra.example.json) y este
# forzado NO se le aplica -- conecta siempre a su host real con esas credenciales.
DB_FORCE_HOST=localhost

# Auth
JWT_SECRET=
JWT_EXPIRES=8h

# Adjuntos
UPLOAD_DIR=./uploads

# Usuarios ICG (separados por coma) que ven la Consola Banesco, el botón "Actualizar Banesco"
# y Admin -> Seguimiento ICG. Vacío = REDESIP.
SUPERUSUARIOS=REDESIP

# Seguimiento de ICG (Admin -> Seguimiento ICG). "simular" (o vacío) = solo detecta y lista,
# sin cambiar nada; "aplicar" = lo hace. Se lee al arrancar el backend.
#   REABIERTOS: gasto saldado en ICG que vuelve a quedar pendiente -> vuelve a Pagos.
#   TRANSFERIDOS: gasto de mayores (TOP GROUP / MAYORES) cuya factura de tienda ya está en
#   el flujo -> pasa a Transferido.
SEGUIMIENTO_ICG_REABIERTOS=simular
SEGUIMIENTO_ICG_TRANSFERIDOS=simular

# Actualizador (Admin -> seccion /actualizador, clave propia, no ligada a ICG)
# Descarga el .zip del branch indicado de un repo PUBLICO de GitHub y lo aplica.
UPDATER_PASSWORD=
UPDATE_REPO_OWNER=
UPDATE_REPO_NAME=
UPDATE_REPO_BRANCH=main
